# 示例说明文件；Spring Boot 不会自动加载 .env，请在启动进程的环境中设置。
DB_URL=jdbc:mysql://127.0.0.1:3306/charity_donation?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai
DB_USERNAME=root
DB_PASSWORD=<数据库密码>
SERVER_PORT=8080
DEMO_DATA_ENABLED=false
DEMO_ADMIN_USERNAME=<演示管理员用户名>
DEMO_ADMIN_PASSWORD=<至少8位的演示管理员密码>
